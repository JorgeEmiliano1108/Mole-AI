
// 1. CONFIGURACIÓN INICIAL Y FONDO
document.addEventListener('DOMContentLoaded', () => {
    const chatContainer = document.getElementById('ai-chat-container');
    if(chatContainer) {
        // Ruta relativa desde /static/js/ a /static/assets/
        chatContainer.style.backgroundImage = "url('../assets/topo.png')";
        chatContainer.style.backgroundSize = "150px";
        chatContainer.style.opacity = "1";
    }
    console.log("Mole-AI System Loaded.");
});

// 2. SISTEMA DE INTRODUCCIÓN (Tipo Terminal)
let typingTimer; 
const speed = 15; 

// Usamos los textos detallados de Topo.js
const introData = {
    giro: "OBJETIVO:<br>Desarrollar soluciones tecnológicas de bajo costo para la agricultura urbana.<br><br>GIRO:<br>Agro-tecnología y desarrollo de software educativo.",
    vision: "VISIÓN:<br>Un futuro donde la sabiduría ancestral de la herbolaria mexicana se fusiona con la inteligencia artificial.",
    flora: "FLORA MEXICANA:<br>Catalogar, monitorear y enseñar el cuidado de especies endémicas: Peyote, Cempasúchil y Hongos.",
    web: "ACERCA DE:<br>Mole-IA Protocol v1.0.<br>Sistema de gestión agrícola descentralizado.<br>Ejecución local segura sin conexión al servidor."
};

function updateIntro(key) {
    const display = document.getElementById('intro-text');
    const fullText = introData[key];
    
    if(!fullText) return;

    display.innerHTML = "> "; 
    if (typingTimer) clearInterval(typingTimer);

    let i = 0;
    
    typingTimer = setInterval(() => {
        const char = fullText.charAt(i);
        
        // Manejo de etiquetas HTML en el efecto de tipeo
        if (char === '<') {
            const tagEnd = fullText.indexOf('>', i);
            display.innerHTML += fullText.substring(i, tagEnd + 1);
            i = tagEnd + 1;
        } else {
            display.innerHTML += char;
            i++;
        }

        if (i >= fullText.length) {
            clearInterval(typingTimer);
            display.innerHTML += '<span class="cursor-blink">_</span>';
        }
    }, speed);
}

function irALogin() {
    document.getElementById('start-screen').classList.remove('active');
    document.getElementById('login-screen').classList.add('active');
}

// 3. AUTENTICACIÓN Y REGISTRO (Supabase)

async function entrarSistema() {
    const email = document.getElementById('email-input').value.trim();
    const password = document.getElementById('password-input').value.trim();
    const errorDiv = document.getElementById('login-error');
    
    if (!email || !password) {
        mostrarError('Email y contraseña requeridos');
        return;
    }
    
    try {
        setLoadingButton('.login-btn', 'VERIFICANDO...');
        
        const { data, error } = await window.supabase.auth.signInWithPassword({
            email: email,
            password: password
        });
        
        if (error) throw error;

        // Éxito
        errorDiv.style.display = 'none';
        document.getElementById('login-screen').classList.remove('active');
        document.getElementById('app-screen').classList.add('active');
        iniciarSimulacion();
        console.log('Usuario:', data.user.email);
        
    } catch (err) {
        console.error('Login error:', err);
        let msg = 'Error de conexión';
        if (err.message.includes('Invalid login')) msg = 'Credenciales incorrectas';
        if (err.message.includes('not confirmed')) msg = 'Confirma tu email primero';
        mostrarError(msg);
    } finally {
        resetButton('.login-btn', 'ENTRAR >>');
    }
}

function mostrarRegistro() {
    document.querySelector('.login-title').textContent = 'NUEVO REGISTRO';
    const loginBtn = document.querySelector('.login-btn');
    loginBtn.textContent = 'CONFIRMAR >>';
    loginBtn.setAttribute('onclick', 'registrarUsuario()');
    
    toggleBotonesRegistro(true); // Ocultar crear, mostrar volver
    limpiarFormulario();
}

function volverALogin() {
    document.querySelector('.login-title').textContent = 'ACCESO SEGURO';
    const loginBtn = document.querySelector('.login-btn');
    loginBtn.textContent = 'ENTRAR >>';
    loginBtn.setAttribute('onclick', 'entrarSistema()');
    
    toggleBotonesRegistro(false); // Mostrar crear, ocultar volver
    limpiarFormulario();
}

async function registrarUsuario() {
    const email = document.getElementById('email-input').value.trim();
    const password = document.getElementById('password-input').value.trim();
    
    if (!validarRegistro(email, password)) return;
    
    try {
        setLoadingButton('.login-btn', 'PROCESANDO...');
        
        const { data, error } = await window.supabase.auth.signUp({
            email: email,
            password: password,
            options: { emailRedirectTo: window.location.origin }
        });
        
        if (error) throw error;

        mostrarExito(':: CONFIRMACIÓN ENVIADA. REVISA TU EMAIL ::');
        limpiarFormulario(false); // No borrar mensaje
        setTimeout(volverALogin, 5000);
        
    } catch (err) {
        let msg = 'Error en registro';
        if (err.message.includes('already registered')) msg = 'Email ya registrado';
        mostrarError(msg);
    } finally {
        resetButton('.login-btn', 'CONFIRMAR >>');
    }
}

// 4. LÓGICA DE SIMULACIÓN Y BASE DE DATOS LOCAL

let plantaActual = 'manzanilla';

const db = {
    manzanilla: { hum: "65", ph: "6.2", region: "Europa/México", temporada: "Primavera", prop: "Calmante, antiinflamatorio.", uso: "Té para el estrés, compresas para ojos.", receta: "Hervir 1 cda de flores secas en 1 taza de agua por 5 min." },
    sabila: { hum: "20", ph: "7.1", region: "Árida", temporada: "Anual", prop: "Cicatrizante, hidratante.", uso: "Gel para quemaduras, mascarillas.", receta: "Cortar hoja, extraer cristal, lavar bien y aplicar." },
    menta: { hum: "80", ph: "6.5", region: "Húmeda", temporada: "Primavera", prop: "Digestiva, refrescante.", uso: "Aceite esencial, infusión.", receta: "Macerar hojas frescas en alcohol para tintura." },
    lavanda: { hum: "35", ph: "6.8", region: "Seca", temporada: "Verano", prop: "Relajante, antiséptico.", uso: "Aromaterapia, saquitos de olor.", receta: "Secar ramos boca abajo en lugar oscuro y ventilado." },
    cempasuchil: { hum: "50", ph: "6.0", region: "México", temporada: "Otoño", prop: "Antioxidante, ritual.", uso: "Ofrenda de Día de Muertos, pigmento.", receta: "Infusión de pétalos para malestares estomacales leves." },
    bugambilia: { hum: "40", ph: "6.0", region: "Cálida", temporada: "Todo año", prop: "Antitusiva, expectorante.", uso: "Té para la tos y bronquitis.", receta: "Hervir un puño de flores con canela y endulzar con miel." },
    toronjil: { hum: "60", ph: "7.0", region: "Bosque", temporada: "Verano", prop: "Sedante suave, antiviral.", uso: "Té para nervios y sueño.", receta: "Infusión suave de hojas frescas antes de dormir." },
    peyote: { hum: "10", ph: "7.5", region: "Desierto", temporada: "Lento", prop: "Psicoactivo, sagrado.", uso: "Ritual y ceremonial (uso tradicional).", receta: "Consumo ceremonial bajo guía experta (no es una receta común)." },
    hongos: { hum: "90", ph: "6.0", region: "Bosque Niebla", temporada: "Lluvias", prop: "Nootrópico, inmunomodulador.", uso: "Suplementos, microdosis.", receta: "Secado y pulverizado para encapsular o consumo directo." }
};

function iniciarSimulacion() {
    // Actualización inmediata al entrar
    actualizarSensores(); 
    // Ciclo de actualización
    setInterval(actualizarSensores, 3000);
}

function actualizarSensores() {
    const data = db[plantaActual];
    if(!data) return;

    const baseHum = parseInt(data.hum);
    const basePh = parseFloat(data.ph);
    
    // Variación aleatoria pequeña para realismo
    const randomHum = Math.floor(Math.random() * 5) - 2;
    const randomPh = (Math.random() * 0.2) - 0.1;
    
    const finalHum = baseHum + randomHum;
    const finalPh = (basePh + randomPh).toFixed(1);

    document.getElementById('disp-hum').innerText = finalHum + "%";
    document.getElementById('disp-ph').innerText = finalPh;

    // Estado de Salud Aleatorio
    const healthBox = document.getElementById('health-box');
    const healthText = document.getElementById('disp-health');
    const azar = Math.random();
    
    if(azar > 0.95) { 
        healthBox.className = "stat-block danger"; 
        healthText.innerText = "!"; 
    } else if (azar > 0.85) { 
        healthBox.className = "stat-block warning"; 
        healthText.innerText = "REVISAR"; 
    } else { 
        healthBox.className = "stat-block"; 
        healthText.innerText = "OK"; 
    }
}

function cambiarPlanta(key, btn) {
    plantaActual = key;
    
    // Actualizar Tabs
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    
    // Actualizar Icono
    document.querySelectorAll('.plant-icon').forEach(i => i.classList.remove('active'));
    const icon = document.getElementById('icon-' + key);
    if(icon) icon.classList.add('active');
    
    // Actualizar Datos inmediatos
    actualizarSensores();
}

function toggleSys(el) {
    const spanVal = el.querySelector('.stat-value');
    const title = el.querySelector('.stat-title');
    
    if(spanVal.innerText === "OFF") { 
        spanVal.innerText = "ON"; 
        el.style.background = "var(--pip-green)"; 
        title.style.background = "#000"; title.style.color = "var(--pip-green)";
        spanVal.style.color = "#000"; spanVal.style.textShadow = "none";
    } else { 
        spanVal.innerText = "OFF"; 
        el.style.background = "rgba(0, 20, 0, 0.6)"; 
        title.style.background = "var(--pip-green)"; title.style.color = "#000";
        spanVal.style.color = "var(--pip-green)"; spanVal.style.textShadow = "0 0 5px var(--pip-green)";
    }
}

// 5. CHAT SIMULADO (Local)
function abrirChat() {
    document.getElementById('ai-modal').style.display = 'flex';
    document.getElementById('ai-input').focus();
}

function cerrarChat() { 
    document.getElementById('ai-modal').style.display = 'none'; 
}

function enviarComandoAI() {
    const input = document.getElementById('ai-input');
    const chatContainer = document.getElementById('ai-chat-container');
    const txt = input.value.toLowerCase().trim();
    
    if(!txt) return;

    // Mensaje Usuario
    chatContainer.innerHTML += `<div class="ai-message user">${input.value}</div>`;
    input.value = "";
    chatContainer.scrollTop = chatContainer.scrollHeight;

    // Respuesta Bot (Simulada)
    setTimeout(() => {
        const data = db[plantaActual];
        let response = `> Analizando ${plantaActual.toUpperCase()}...`;

        if(txt.includes('riego') || txt.includes('agua') || txt.includes('humedad')) {
            response += `<br>Humedad ideal: ${data.hum}%. Nivel actual estable.`;
        } 
        else if(txt.includes('ph') || txt.includes('suelo')) {
            response += `<br>pH Objetivo: ${data.ph}. Suelo en rango.`;
        }
        else if(txt.includes('estado') || txt.includes('salud')) {
            const estado = document.getElementById('disp-health').innerText;
            response += `<br>Diagnóstico: ${estado === 'OK' ? 'Sistemas Nominales.' : '¡ANOMALÍA DETECTADA!'}`;
        }
        else if(txt.includes('propiedad') || txt.includes('sirve') || txt.includes('beneficio')) {
             response += `<br>PROPIEDADES: ${data.prop}<br>REGIÓN: ${data.region}<br>TEMPORADA: ${data.temporada}`;
        }
        else if(txt.includes('uso') || txt.includes('aplicacion')) {
            response += `<br>USOS RECOMENDADOS: ${data.uso}`;
        }
        else if(txt.includes('receta') || txt.includes('preparar') || txt.includes('te')) {
            response += `<br>PROTOCOLO DE PREPARACIÓN:<br>${data.receta}`;
        }
        else {
            response += `<br>Comando desconocido. Intenta: "propiedades", "receta", "riego", "estatus".`;
        }

        chatContainer.innerHTML += `<div class="ai-message bot">${response}</div>`;
        chatContainer.scrollTop = chatContainer.scrollHeight;
    }, 800);
}

// --- UTILIDADES (Helpers) ---

function toggleBotonesRegistro(esRegistro) {
    const registerBtn = document.querySelector('.register-btn');
    const loginBtn = document.querySelector('.login-btn');
    
    if (esRegistro) {
        if (registerBtn) registerBtn.style.display = 'none';
        crearBotonVolver(loginBtn);
    } else {
        if (registerBtn) registerBtn.style.display = 'block';
        const volverBtn = document.querySelector('.volver-btn');
        if (volverBtn) volverBtn.remove();
    }
}

function crearBotonVolver(referenceNode) {
    if (document.querySelector('.volver-btn')) return;
    
    const volverBtn = document.createElement('button');
    volverBtn.className = 'volver-btn';
    volverBtn.textContent = '[ VOLVER ]';
    volverBtn.setAttribute('onclick', 'volverALogin()');
    // Estilos inline para asegurar consistencia
    volverBtn.style.cssText = `
        background: transparent; border: 2px solid var(--pip-green); color: var(--pip-green);
        padding: 8px 16px; margin-top: 10px; font-family: 'VT323', monospace; font-size: 16px;
        cursor: pointer; text-transform: uppercase; transition: all 0.3s ease; width: 100%;
    `;
    volverBtn.onmouseover = () => { volverBtn.style.background = 'var(--pip-green)'; volverBtn.style.color = '#000'; };
    volverBtn.onmouseout = () => { volverBtn.style.background = 'transparent'; volverBtn.style.color = 'var(--pip-green)'; };
    
    referenceNode.parentNode.insertBefore(volverBtn, referenceNode.nextSibling);
}

function mostrarError(msg) {
    const errorDiv = document.getElementById('login-error');
    errorDiv.textContent = msg;
    errorDiv.style.display = 'block';
    errorDiv.style.color = '#ff4444';
}

function mostrarExito(msg) {
    const errorDiv = document.getElementById('login-error');
    errorDiv.textContent = msg;
    errorDiv.style.display = 'block';
    errorDiv.style.color = '#44ff44';
}

function limpiarFormulario(borrarError = true) {
    document.getElementById('email-input').value = '';
    document.getElementById('password-input').value = '';
    if(borrarError) {
        document.getElementById('login-error').style.display = 'none';
    }
    document.getElementById('email-input').focus();
}

function setLoadingButton(selector, text) {
    const btn = document.querySelector(selector);
    btn.textContent = text;
    btn.disabled = true;
}

function resetButton(selector, text) {
    const btn = document.querySelector(selector);
    btn.textContent = text;
    btn.disabled = false;
}

function validarRegistro(email, password) {
    if (!email || !password) { mostrarError('Campos requeridos'); return false; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { mostrarError('Email inválido'); return false; }
    if (password.length < 6) { mostrarError('Mínimo 6 caracteres'); return false; }
    return true;
}