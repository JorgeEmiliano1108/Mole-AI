{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mole.ai/schemas/safety/v1.json",
  "title": "Mole.AI Safety Data Schema v1",
  "description": "Contrato de validación para umbrales de agroquímicos y especies protegidas por NOM-059-SEMARNAT.",
  "oneOf": [
    {
      "$ref": "#/definitions/AgrochemicalLimitList"
    },
    {
      "$ref": "#/definitions/Nom059SpeciesList"
    }
  ],
  "definitions": {
    "AgrochemicalLimitList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/AgrochemicalLimit"
      }
    },
    "AgrochemicalLimit": {
      "type": "object",
      "required": [
        "id",
        "name",
        "active_ingredient",
        "max_dose_per_hectare",
        "unit",
        "max_applications_per_cycle",
        "reentry_interval_hours",
        "phi_days"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "description": "Identificador canónico del agroquímico."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Nombre comercial o genérico."
        },
        "active_ingredient": {
          "type": "string",
          "minLength": 1,
          "description": "Ingrediente activo principal."
        },
        "category": {
          "type": "string",
          "enum": ["fungicide", "herbicide", "insecticide", "nematicide", "molluscicide", "other"],
          "description": "Clasificación toxicológica/agrónoma."
        },
        "max_dose_per_hectare": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Dosis máxima permitida por hectárea según condiciones normales."
        },
        "unit": {
          "type": "string",
          "enum": ["g/ha", "kg/ha", "ml/ha", "l/ha"],
          "description": "Unidad de la dosis."
        },
        "max_applications_per_cycle": {
          "type": "integer",
          "minimum": 1,
          "description": "Máximo número de aplicaciones por ciclo agrícola."
        },
        "reentry_interval_hours": {
          "type": "integer",
          "minimum": 0,
          "description": "Horas de carencia para reingreso de personal."
        },
        "phi_days": {
          "type": "integer",
          "minimum": 0,
          "description": "Periodo de carencia previo a la cosecha (Pre-Harvest Interval)."
        },
        "restricted_crops": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Culturos donde su uso está restringido o prohibido."
        },
        "forbidden_regions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Regiones/zonas donde su uso está prohibido."
        },
        "notes": {
          "type": "string",
          "description": "Notas regulatorias o de seguridad."
        }
      }
    },
    "Nom059SpeciesList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Nom059Species"
      }
    },
    "Nom059Species": {
      "type": "object",
      "required": [
        "id",
        "scientific_name",
        "common_names",
        "protection_status",
        "category",
        "warning"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "description": "Identificador canónico de la especie."
        },
        "scientific_name": {
          "type": "string",
          "minLength": 1,
          "description": "Nombre científico binomial."
        },
        "common_names": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Nombres comunes en México."
        },
        "protection_status": {
          "type": "string",
          "enum": ["protected", "endangered", "threatened", "special_protection"],
          "description": "Estatus de protección general."
        },
        "category": {
          "type": "string",
          "enum": ["P", "A", "Pr", "E"],
          "description": "Categoría NOM-059-SEMARNAT: P=En peligro de extinción, A=Amenazada, Pr=Sujeta a protección especial, E=Probablemente extinta en el medio silvestre."
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "description": "Enlace oficial a la lista SEMARNAT."
        },
        "warning": {
          "type": "string",
          "minLength": 1,
          "description": "Mensaje obligatorio de advertencia legal."
        }
      }
    }
  }
}
