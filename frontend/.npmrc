# ══════════════════════════════════════════════════════════════
# Mole.AI Frontend — pnpm Security Policy
# SEV-1 Supply Chain Hardening
# ══════════════════════════════════════════════════════════════

# Block ALL lifecycle scripts globally (postinstall, preinstall, install)
ignore-scripts=true

# Reject installs with unresolved peer dependency conflicts
strict-peer-dependencies=true

# Auto-resolve peer dependencies without manual lockfile intervention
auto-install-peers=true

# Resolve to highest compatible version for reproducibility
resolution-mode=highest
