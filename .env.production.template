# =============================================================================
# Mole.AI — Production Environment Template (.env.production.template)
# Target: EC2 t3.medium (Single-Node Docker Compose) + Amazon S3
# =============================================================================
# INSTRUCCIONES:
#   1. Copiar este archivo: cp .env.production.template .env
#   2. Rellenar TODOS los campos marcados con <REPLACE_ME>
#   3. Nunca comitear el .env resultante al repositorio (está en .gitignore)
#   4. Preferiblemente inyectar secretos via AWS Secrets Manager o Parameter Store
# =============================================================================


# ── CORE DJANGO ───────────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=<REPLACE_ME>                          # min 50 chars, random string
JWT_SECRET_KEY=<REPLACE_ME>                      # usado por LocalJWTAuthentication
JWT_ALGORITHM=HS256

# Reemplaza con la IP pública o dominio de tu EC2
ALLOWED_HOSTS=<REPLACE_ME>
CSRF_TRUSTED_ORIGINS=http://<REPLACE_ME>

# Seguridad HTTP (dejar en 0 si no hay TLS todavía)
SECURE_HSTS_SECONDS=0
SECURE_SSL_REDIRECT=False

# Brute-force protection
AXES_FAILURE_LIMIT=5


# ── DATABASE (External RDS PostgreSQL) ────────────────────────────────────────
POSTGRES_DB=<REPLACE_ME>
POSTGRES_USER=<REPLACE_ME>
POSTGRES_PASSWORD=<REPLACE_ME>
POSTGRES_HOST=<REPLACE_ME>
POSTGRES_PORT=<REPLACE_ME>

# DATABASE_URL alternativo (toma prioridad si se define)
# Formato: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://<REPLACE_ME_DB_USER>:<REPLACE_ME_DB_PASSWORD>@<REPLACE_ME_RDS_ENDPOINT>:5432/<REPLACE_ME_DB_NAME>


# ── AWS S3 STORAGE ────────────────────────────────────────────────────────────
# MinIO removido. Toda la media y assets de entrenamiento van a S3.
USE_S3=True
AWS_ACCESS_KEY_ID=<REPLACE_ME_AWS_ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<REPLACE_ME_AWS_SECRET_KEY>
AWS_STORAGE_BUCKET_NAME=<REPLACE_ME>
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=                             # Dejar vacío → boto3 usa endpoint nativo de AWS

# Bucket compartido para datos de entrenamiento (puede ser el mismo)
TRAINING_BUCKET_NAME=<REPLACE_ME>               # ej. mole-ai-training-data

# MS3 Reports S3 (puede apuntar al mismo bucket o a uno dedicado)
MS3_S3_ACCESS_KEY=<REPLACE_ME>
MS3_S3_SECRET_KEY=<REPLACE_ME>
MS3_S3_BUCKET=<REPLACE_ME>
MS3_S3_ENDPOINT=                                 # Dejar vacío → S3 nativo


# ── INTERNAL ROUTING (Docker Compose service names) ──────────────────────────
# Estos valores NO cambian en un deploy single-node. Son resolución DNS interna de Docker.
DJANGO_BASE_URL=http://django-backend:8000
DJANGO_VALIDATE_TOKEN_PATH=/api/v1/auth/validate/
PORT=8000
HOST=0.0.0.0


# ── AI MICROSERVICES ──────────────────────────────────────────────────────────
# URLs internas (red Docker Compose) — no exponer al exterior
FASTAPI_URL=http://ms2_chat:8002
FASTAPI_EXTERNAL_PORT=8002
MOLE_AI_TIMEOUT=120
MOLE_AI_API_KEY=<REPLACE_ME>

# Modelos de Vision (MS1)
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
VISION_CONFIDENCE_THRESHOLD=0.65

# Modelos de Lenguaje (MS2 RAG / MS3 Reportes)
NVIDIA_API_KEY=<REPLACE_ME_NVIDIA_NIM_KEY>
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_REPORT_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_EMBEDDING_DIMENSION=1024

# RAG vector store
VECTOR_DB_PATH=/app/storage/vectors

CORS_ALLOWED_ORIGINS=http://<YOUR_EC2_PUBLIC_IP>


# ── HARDWARE / IoT AUTH ───────────────────────────────────────────────────────
HARDWARE_API_KEY=<REPLACE_ME>                    # Clave compartida ESP32 ↔ Django
ADMIN_API_KEY=<REPLACE_ME>
FARMER_API_KEY=<REPLACE_ME>


# ── REDIS (Broker de Celery + Channel Layer) ──────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1


# ── MQTT BROKER (Mosquitto en EC2) ────────────────────────────────────────────
MQTT_BROKER_HOST=mqtt_broker
MQTT_BROKER_PORT=1883


# ── IoT EDGE NODE ─────────────────────────────────────────────────────────────
EDGE_DB_PATH=/app/data/edge_mole.sqlite3
SYNC_INTERVAL=30

# WAN target: URL del backend cloud para sincronización Store & Forward
# El daemon intentará CLOUD_API_URL primero, luego BACKEND_BATCH_URL
CLOUD_API_URL=http://<YOUR_EC2_PUBLIC_IP>/api/v1/sensor-data/batch/
BACKEND_BATCH_URL=http://django-backend:8000/api/v1/sensor-data/batch/

# TLS para WebSocket del Edge Node (dejar vacío si no hay certs)
TLS_CERT_PATH=
TLS_KEY_PATH=

# Modelo TFLite local del nodo ESP32 gateway
TFLITE_MODEL_PATH=models/ph_regression.tflite

# MQTT local físico (red del campo, para el daemon de edge)
MQTT_LOCAL_HOST=<IP_DEL_ROUTER_DE_CAMPO>
MQTT_LOCAL_PORT=1883


# ── BOTANICAL APIs (opcional) ─────────────────────────────────────────────────
TREFLE_API_TOKEN=
OPENWEATHER_API_KEY=<REPLACE_ME>


# ── OBSERVABILITY ─────────────────────────────────────────────────────────────
# Prometheus corre en el mismo EC2. No exponer puerto 9090 a internet.
# Configurar Security Group de AWS para restringir acceso.
