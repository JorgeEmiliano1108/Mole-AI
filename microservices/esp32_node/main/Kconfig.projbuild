menu "Mole.AI Node Configuration"

    config MQTT_BROKER_URI
        string "Mole.AI MQTT Broker URI"
        default "mqtt://192.168.1.100:1883"
        help
            MQTT endpoint of the Edge Node broker.
            Format: mqtt://<edge_node_ip>:<port>

    config HARDWARE_API_KEY
        string "Mole.AI Hardware API Key"
        default ""
        help
            API Key required for M2M authentication with Django backend.
            This field is mandatory.

    config MOLE_I2C_SDA
        int "I2C SDA GPIO"
        default 21
        help
            GPIO pin for I2C data line (DHT20 + LTR390).

    config MOLE_I2C_SCL
        int "I2C SCL GPIO"
        default 22
        help
            GPIO pin for I2C clock line (DHT20 + LTR390).

    config MOLE_SOIL_ADC_CHANNEL
        int "Soil Moisture ADC Channel"
        default 6
        help
            ADC1 channel for the capacitive soil moisture sensor.
            Channel 6 = GPIO34 on ESP32.

    config MOLE_TELEMETRY_INTERVAL_MS
        int "Telemetry interval (ms)"
        default 300000
        help
            Interval between telemetry reports in milliseconds.
            Default: 300000 (5 minutes).

    config MOLE_NTP_SERVER_PRIMARY
        string "Primary NTP server"
        default "pool.ntp.org"

    config MOLE_NTP_SERVER_SECONDARY
        string "Secondary NTP server"
        default "time.google.com"

    config MOLE_NTP_SERVER_TERTIARY
        string "Tertiary NTP server"
        default "time.cloudflare.com"

endmenu
