# Development Dockerfile
# Optimized for development with virtual environment support

FROM python:3.11-slim as base

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    postgresql-client \
    curl \
    git \
    vim \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements first for better layer caching
COPY requirements.txt .

# Mount virtual environment if it exists (host path)
VOLUME ["/opt/venv"]

# Install or use virtual environment
RUN if [ -d "/opt/venv" ]; then \
        echo "Using existing virtual environment"; \
        ln -sf /opt/venv/bin/pip /usr/local/bin/pip; \
        pip install --upgrade pip; \
        /opt/venv/bin/pip install -r requirements.txt; \
    else \
        echo "Creating new virtual environment"; \
        python -m venv /opt/venv; \
        /opt/venv/bin/pip install --upgrade pip; \
        /opt/venv/bin/pip install -r requirements.txt; \
    fi

# Copy application code
COPY . .

# Make virtual environment active
ENV PATH="/opt/venv/bin:$PATH"

# Create non-root user for development
RUN groupadd -r django && useradd -r -g django django && \
    usermod -aG sudo django

# Change ownership for development
RUN chown -R django:django /app /opt/venv

# Switch to non-root user for development
USER django

# Health check for development
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Development ports
EXPOSE 8000

# Development command with auto-reload
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]