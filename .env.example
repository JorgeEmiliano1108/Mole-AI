# .env.example — Plantilla del único archivo global de entorno (NO commitear `.env`).
#
# Copiar a `.env` y rellenar con secretos reales (gestor de secretos en prod:
# Vault / AWS Secrets Manager / Azure Key Vault). Este archivo solo lleva
# PLACEHOLDERS — jamás credenciales válidas.
#
# Estándar único de nombres: canónicos genéricos `DB_*/JWT_*/EDGE_*/AI_SERVICE_URL`
# (ver `core_backend/mole_ai_backend/settings.py::_env_first`: canónico primero,
# legacy `POSTGRES_*/DATABASE_URL/SUPABASE_*/FASTAPI_URL` solo como fallback de
# transición). `entrypoint.sh` y `docker-compose.test.yml` exigen canónicos.
# Cada bloque documenta su consumidor en código.

# ── Django gateway (core_backend/mole_ai_backend/settings.py) ──────────────
DEBUG=False
SECRET_KEY=change-me-min-50-chars
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_BASE_URL=http://localhost:8000
SECURE_HSTS_SECONDS=31536000
SECURE_SSL_REDIRECT=False
CSRF_TRUSTED_ORIGINS=http://localhost:8080

# ── Auth JWT local HS256 (apps/authentication; contratos docs/mobile-contract.md §1)
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=20
AXES_FAILURE_LIMIT=5

# ── Base de datos (settings.py::_resolve_db_url; entrypoint.sh la espera) ──
# Opción A (partes, Compose local): DB_HOST=nombre del servicio postgres.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=mole_dev
DB_USER=mole
DB_PASSWORD=change-me-db-password
# Opción B (DSN único, RDS/prod): tiene prioridad sobre las partes.
DB_URL=
# NOTA: el servicio `postgres` del compose consume POSTGRES_* (interfaz oficial
# de la imagen pgvector): POSTGRES_DB=${DB_NAME}, POSTGRES_USER=${DB_USER},
# POSTGRES_PASSWORD=${DB_PASSWORD}. No renombrar del lado de la imagen.

# ── Redis/Celery (settings.py; microservices leen REDIS_URL) ───────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Objeto/S3 (settings.py OBJECT_STORAGE_*; MinIO local / AWS prod) ───────
OBJECT_STORAGE_ENABLED=True
OBJECT_STORAGE_ENDPOINT_URL=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=change-me-minio-secret
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET_MEDIA=mole-training-data
OBJECT_STORAGE_BUCKET_TRAINING=mole-training-data
OBJECT_STORAGE_BUCKET_REPORTS=mole-reports

# ── Microservicios IA (MS1 visión / MS2 chat; ADR-0004) ─────────────────────
AI_SERVICE_URL=http://ms2_chat:8002
MOLE_AI_TIMEOUT=120
NVIDIA_API_KEY=change-me-nvidia-key
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=
LLM_VISION_MODEL=
LLM_EMBEDDING_MODEL=
LLM_EMBEDDING_DIMENSION=
VISION_CONFIDENCE_THRESHOLD=0.7
TFLITE_MODEL_PATH=assets/models/plant_mobilenetv2_38.tflite

# ── Clima (apps/core/views.py weather proxy) ───────────────────────────────
OPENWEATHER_API_KEY=change-me-openweather-key

# ── Hardware/edge (edge_node/store_forward_daemon.py; ESP32 TLS) ───────────
HARDWARE_API_KEY=change-me-hardware-key
EDGE_API_KEY=change-me-edge-key
EDGE_SYNC_URL=http://django-backend:8000/api/v1/sync/batch/
EDGE_DB_PATH=/data/edge_store.sqlite3
EDGE_IDENTITY_USER=edge
EDGE_IDENTITY_PASSWORD=change-me-edge-password
SYNC_INTERVAL=300
MQTT_BROKER_URI=mqtt://mosquitto:1883
MQTT_FIELD_HOST=mosquitto
MQTT_FIELD_PORT=1883
MQTT_TLS_ENABLED=False
TLS_CERT_PATH=infrastructure/mosquitto/certs/mqtt.crt
TLS_KEY_PATH=infrastructure/mosquitto/certs/mqtt.key

# ── API pública / Flask (API_PUBLIC_BASE_URL la sirve nginx) ───────────────
HOST=0.0.0.0
PORT=8000
API_INTERNAL_BASE_URL=http://django-backend:8000/api/v1
API_PUBLIC_BASE_URL=http://localhost:8080/api/v1
BOTANICAL_API_TOKEN=
IDP_BASE_URL=
IDP_JWT_SECRET=
IDP_SERVICE_KEY=
FASTAPI_URL=http://ms2_chat:8002

# ── Operativa local (scripts/; setup_superuser; tests) ─────────────────────
DJANGO_SUPERUSER_PASSWORD=change-me-superuser-password
DJANGO_LTK_ENCRYPTION_KEY=change-me-32-bytes-ltk-key-xxxxxxxx
DJANGO_MQTT_SECRET=change-me-mqtt-secret
TEST_USER_EMAIL=test@mole.ai
TEST_USER_PASSWORD=change-me-test-password
SENTRY_DSN=
VECTOR_DB_PATH=/data/pgvector
