# Mole.AI — Example environment variables
# Copy this file to .env and fill values. DO NOT commit your .env file.

# General
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# PostgreSQL / Supabase DB
SUPABASE_DB_NAME=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432

# Supabase Platform
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_SERVICE_ROLE_KEY=

# Supabase S3 / MinIO (optional)
SUPABASE_S3_BUCKET=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=

# HuggingFace / AI Models
HUGGINGFACE_API_KEY=
HF_MODEL_NAME=
HF_INFERENCE_API_URL=
VISION_MODEL_NAME=
HF_API_TIMEOUT=30
HF_MAX_RETRIES=3
EMBEDDING_MODEL_ID=
LLM_MODEL_ID=

# RAG Service
VECTOR_DB_PATH=/app/storage/vectors
VISION_BACKEND=mock
CORS_ALLOWED_ORIGINS=

# Inter-service
FASTAPI_URL=
FASTAPI_EXTERNAL_PORT=8002
MOLE_AI_TIMEOUT=120
MOLE_AI_API_KEY=

# Hardware / IoT
HARDWARE_API_KEY=
ADMIN_API_KEY=
FARMER_API_KEY=

# Redis
REDIS_URL=redis://redis:6379/0

# MQTT Broker
MQTT_BROKER_HOST=mqtt_broker
MQTT_BROKER_PORT=1883

# External APIs (optional)
TREFLE_API_TOKEN=
PLANTILLAGE_API_KEY=

# Edge Node
EDGE_DB_PATH=edge_mole.sqlite3
SYNC_INTERVAL=30
TFLITE_MODEL_PATH=

# Docker / Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=mole_ai_db

# MinIO / S3 credentials
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# MS3 S3 credentials
MS3_S3_ACCESS_KEY=
MS3_S3_SECRET_KEY=
MS3_S3_BUCKET=reports
MS3_S3_ENDPOINT=

# Monitoring
SENTRY_DSN=
# ===========================================================================
#  Mole AI — Environment Variables Template
#  Copy this file to .env and fill in the real values before running.
#  Usage:  cp .env.example .env
# ===========================================================================

# ── General ────────────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# ── PostgreSQL / Supabase DB (Docker defaults) ───────────────────────────
SUPABASE_DB_NAME=mole_ai_db
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=postgres
SUPABASE_DB_HOST=db
SUPABASE_DB_PORT=5432

# ── Supabase Platform ────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=
SUPABASE_JWT_SECRET=your-jwt-secret-here
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase S3 Storage (optional) ──────────────────────────────────────
SUPABASE_S3_BUCKET=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=us-east-1

# ── HuggingFace / AI Models ─────────────────────────────────────────────
HUGGINGFACE_API_KEY=hf_your_key_here
HF_MODEL_NAME=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
HF_INFERENCE_API_URL=https://api-inference.huggingface.co/models/deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
VISION_MODEL_NAME=deepseek-ai/deepseek-vl2-tiny
HF_API_TIMEOUT=30
HF_MAX_RETRIES=3
EMBEDDING_MODEL_ID=
LLM_MODEL_ID=

# ── RAG Service Config ──────────────────────────────────────────────────
VECTOR_DB_PATH=/app/storage/vectors
VISION_BACKEND=mock
CORS_ALLOWED_ORIGINS=

# ── Mole AI Inter-Service ───────────────────────────────────────────────
# Note: Code uses FASTAPI_URL, not MOLE_AI_SERVICE_URL
FASTAPI_URL=http://fastapi_rag:8002/api/v1/mole-ai/chat
MOLE_AI_TIMEOUT=120
MOLE_AI_API_KEY=

# ── Hardware / IoT Auth ──────────────────────────────────────────────────
# IMPORTANT: Change these values in production!
HARDWARE_API_KEY=
ADMIN_API_KEY=
FARMER_API_KEY=

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MQTT Broker ──────────────────────────────────────────────────────────
MQTT_BROKER_HOST=mqtt_broker
MQTT_BROKER_PORT=1883

# ── Botanical APIs (optional) ───────────────────────────────────────────
TREFLE_API_TOKEN=
FARMVILLAGE_API_KEY=

# ── Edge Node (optional — only for store-forward daemon) ────────────────
EDGE_DB_PATH=edge_mole.sqlite3
SYNC_INTERVAL=30
TFLITE_MODEL_PATH=models/ph_regression.tflite
MQTT_LOCAL_HOST=192.168.1.1
MQTT_LOCAL_PORT=1883
