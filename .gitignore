# ===========================================================================
#  Mole AI v2.1 — .gitignore MAESTRO
#  Arquitectura: Edge (ESP-IDF) / Backend (Django) / Frontend (Vanilla JS) / Infra (Docker)
# ===========================================================================
# Este archivo sigue la estructura del monorepo y está organizado por secciones.
# Última actualización: 2026-04-24

# ═══════════════════════════════════════════════════════════════════════════════
# 1. SECRETOS Y CREDENCIALES (CRÍTICO - NUNCA COMMITEAR)
# ═══════════════════════════════════════════════════════════════════════════════
# Archivos de entorno con valores reales
.env
.env.*
!.env.example                     # Mantener solo el ejemplo, no el real

# Certificados y claves privadas
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*. keystore
ssh_rsa*
id_rsa*
id_ed25519*
*.secret

# Configuración de cloud providers (no subir credenciales)
aws_credentials.json
gcp-credentials.json
*.firebaseio.com
google-services.json
firebase-config.json

# Archivos de Supabase/DB externos
.supabase/
supabase-service-key.json

# Baseline de detección de secretos (trufflehog)
.secrets.baseline

# ═══════════════════════════════════════════════════════════════════════════════
# 2. HARDWARE EDGE — ESP-IDF / ESP32
# ═══════════════════════════════════════════════════════════════════════════════
# Compilación
build/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
cmake_*.txt
compile_commands.json

# Binarios compilados (MUY PESADOS - no subir)
*.bin
*.elf
*.map
*.out
firmware/*.bin

# Configuración local del desarrollador (contiene credenciales WiFi)
sdkconfig
sdkconfig.old
sdkconfig.defaults

# Particiones compiladas
partitions.bin
bootloader.bin
ota_data_initial.bin

# NVS (Non-Volatile Storage) — datos de usuario
nvs.bin
nvs_keys.bin

# Flash
flash.bin
flash_args
flash_projconf

# Herramientas ESP
esptool.py
espsecure.py
parttool.py

# Managed components (descargados por idf.py)
managed_components/
components/

